# --- providers-app-studio ---
local_resource(
    'app-studio-preview-bridge-key',
    cmd='make app-studio-preview-bridge-dev-key',
    deps=[
        'Makefile',
        'providers/app-studio/hack/preview-bridge-dev-keys.mjs',
    ],
    labels=['providers-app-studio'],
)

# App Studio's durable store is the shared in-cluster providers-db Postgres
# (database "appstudio") — the same store replica claims and project pins live
# in, so multi-replica behavior is real in dev at REPLICA_COUNT=2.

# Generated apps and their coordinator call the hub through its in-cluster
# Service, not the host-only 9443 port-forward. Preserve TLS verification by
# exporting the hub's public CA certificate for App Studio to inject into
# action-enabled development runtimes and append to its own verified Actions
# transport. Production deployments continue to use their system trust.
app_studio_actions_ca_file = '.kcp/app-studio-actions-ca.crt'
app_studio_actions_ca_cmd = '''
set -eu
mkdir -p .kcp
tmp_file="$(mktemp .kcp/app-studio-actions-ca.XXXXXX)"
trap 'rm -f "$tmp_file"' EXIT
kubectl -n %s get secret railgrid-hub-tls -o go-template='{{ index .data "ca.crt" | base64decode }}' > "$tmp_file"
chmod 0644 "$tmp_file"

# Updating the mounted Secret does not restart the Go server that already
# loaded its previous keypair. This covers the one-time migration from the old
# chart-generated identity and any later intentional rotation: never publish a
# CA to App Studio until it verifies the live hub certificate.
verify_live_hub_tls() {
  openssl s_client \
    -connect 127.0.0.1:9443 \
    -servername railgrid-hub.%s.svc \
    -CAfile "$tmp_file" \
    -verify_return_error </dev/null >/dev/null 2>&1
}

if ! verify_live_hub_tls; then
  echo "hub serving certificate does not match railgrid-hub-tls; restarting hub"
  kubectl -n %s rollout restart deployment/railgrid-hub
  kubectl -n %s rollout status deployment/railgrid-hub --timeout=120s

  verified=false
  for _ in $(seq 1 30); do
    if verify_live_hub_tls; then
      verified=true
      break
    fi
    sleep 1
  done
  if [ "$verified" != true ]; then
    echo "hub serving certificate still does not match railgrid-hub-tls after restart" >&2
    exit 1
  fi
fi

if [ -f %s ] && cmp -s "$tmp_file" %s; then
  rm -f "$tmp_file"
else
  mv "$tmp_file" %s
fi
trap - EXIT
''' % (
    hub_namespace,
    hub_namespace,
    hub_namespace,
    hub_namespace,
    app_studio_actions_ca_file,
    app_studio_actions_ca_file,
    app_studio_actions_ca_file,
)
local_resource(
    'app-studio-actions-ca',
    cmd=app_studio_actions_ca_cmd,
    resource_deps=['hub-tls', 'railgrid-hub'],
    labels=['providers-app-studio'],
)


# The exported hub CA file becomes a ConfigMap the app-studio chart mounts
# (hub.actionsCABundleConfigMap) so action-enabled development runtimes keep
# verified TLS to the in-cluster hub Service.
local_resource(
    'app-studio-actions-ca-cm',
    cmd='''
set -eu
kubectl --context %s -n %s create configmap app-studio-actions-ca \
  --from-file=ca-bundle.pem=%s --dry-run=client -o yaml | \
  kubectl --context %s -n %s apply -f -
'''.strip() % (k8s_context(), providers_namespace, app_studio_actions_ca_file,
               k8s_context(), providers_namespace),
    deps=[app_studio_actions_ca_file],
    resource_deps=['app-studio-actions-ca'],
    labels=['providers-app-studio'],
)

# The app-studio init container applies its APIExport with first-party
# permission claims on the infrastructure/code APIExports — kcp REQUIRES
# their identityHashes (empty hash = hard apply failure). The host init
# target auto-discovered them; here a resource does the same lookups and
# writes them to a file that read_file() below watches: the moment discovery
# succeeds (after infrastructure/code exist), Tilt re-renders the chart with
# the hashes and the pods restart with valid claims.
app_studio_hash_file = '.kcp/app-studio-identity-hashes.env'
local_resource(
    'app-studio-identity-hashes',
    cmd='''
set -eu
lookup() {
  kubectl --kubeconfig=%s --server=%s/clusters/root:railgrid:providers:$1 \
    --insecure-skip-tls-verify get apiexport $2 \
    -o jsonpath='{.status.identityHash}' 2>/dev/null || true
}
infra="$(lookup infrastructure infrastructure.providers.railgrid.ai)"
code="$(lookup code code.providers.railgrid.ai)"
if [ -z "$infra" ] || [ -z "$code" ]; then
  echo "identityHashes not discoverable yet (infra='$infra' code='$code')"
  echo "re-trigger after the infrastructure operator has bootstrapped and code-init has run"
  exit 0
fi
printf 'infra=%%s\\ncode=%%s\\n' "$infra" "$code" > %s
echo "wrote %s"
'''.strip() % (KCP_ADMIN_KUBECONFIG, KCP_ADMIN_SERVER, app_studio_hash_file, app_studio_hash_file),
    deps=['.kcp/code-runtime.kubeconfig', 'tilt-frontproxy.kubeconfig'],
    allow_parallel=True,
    labels=['providers-app-studio'],
)

app_studio_infra_hash = cfg.get('app-studio-infra-identity-hash', '')
app_studio_code_hash = cfg.get('app-studio-code-identity-hash', '')
for _line in str(read_file(app_studio_hash_file, '')).splitlines():
    if _line.startswith('infra=') and not app_studio_infra_hash:
        app_studio_infra_hash = _line[len('infra='):].strip()
    if _line.startswith('code=') and not app_studio_code_hash:
        app_studio_code_hash = _line[len('code='):].strip()

# App Studio deliberately stays at one replica even when REPLICA_COUNT=2. Its
# durable run claims and project affinity are replica-aware, but every workspace
# has one shared, single-session Playwright Browser and browser ownership is
# still process-local (docs/app-studio-replica-awareness.md).
#
# The controller manager watches the APIExportEndpointSlice in the PROVIDER
# workspace, so the synced kubeconfig must be the workspace-scoped one init
# writes (.kcp/app-studio-provider.kubeconfig). previewBridge is disabled in
# pod mode for now: the dev signing-key flow generates the key id at runtime,
# which chart values can't consume at render time — App Studio serves without
# the signed annotation bridge (its documented degraded mode).
provider_kubeconfig_sync('app-studio', '.kcp/app-studio-provider.kubeconfig', ['providers-app-studio'])
provider_pod(
    'app-studio', 8085,
    container_port=8081,
    chart_extra=[
        'replicaCount=1',
        'store.databaseURL=%s' % providers_db_url('appstudio'),
        'hub.publicURL=%s' % hub_external_url,
        'hub.actionsExternalURL=https://railgrid-hub.%s.svc:9443' % hub_namespace,
        'hub.actionsCABundleConfigMap.name=app-studio-actions-ca',
        'hub.actionsCABundleConfigMap.key=ca-bundle.pem',
        'previewBridge.enabled=false',
        'apiExport.infraIdentityHash=%s' % app_studio_infra_hash,
        'apiExport.codeIdentityHash=%s' % app_studio_code_hash,
    ],
    resource_deps=[
        'app-studio-secrets',
        'providers-db',
        'app-studio-actions-ca-cm',
        'dev-agent-image',
    ],
)

local_resource(
    'app-studio-register',
    cmd=('{rewrite} && APP_STUDIO_KCP_KUBECONFIG={kc} ' +
         'APP_STUDIO_KCP_SERVER={sv} APP_STUDIO_MANIFEST={mf} ' +
         'make install-provider-app-studio').format(
             rewrite=APP_STUDIO_REWRITE_CMD, kc=KCP_ADMIN_KUBECONFIG,
             sv=KCP_ADMIN_SERVER, mf=APP_STUDIO_MANIFEST_REWRITTEN),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['providers-app-studio'],
)

local_resource(
    'app-studio-init',
    cmd=('APP_STUDIO_KCP_KUBECONFIG={kc} APP_STUDIO_KCP_SERVER={sv} ' +
         'make init-provider-app-studio').format(
             kc=KCP_ADMIN_KUBECONFIG, sv=KCP_ADMIN_SERVER),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub', 'app-studio-register'],
    labels=['providers-app-studio'],
)

local_resource(
    'app-studio-unregister',
    cmd=('{rewrite} && APP_STUDIO_KCP_KUBECONFIG={kc} ' +
         'APP_STUDIO_KCP_SERVER={sv} APP_STUDIO_MANIFEST={mf} ' +
         'make uninstall-provider-app-studio').format(
             rewrite=APP_STUDIO_REWRITE_CMD, kc=KCP_ADMIN_KUBECONFIG,
             sv=KCP_ADMIN_SERVER, mf=APP_STUDIO_MANIFEST_REWRITTEN),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['providers-app-studio'],
)

# --- providers-kuery (fleet query engine, port :8084) ---
# At REPLICA_COUNT=2, both replicas share the providers-db Postgres (the chart
# refuses >1 with SQLite): per-edge Lease claims shard engagement, and every replica
# answers queries/edge listings from the shared store. Engagement needs
# ▶ kuery-register then ▶ kuery-init (mints the runtime kubeconfig the
# secrets sync delivers).
#
# The kubernetesclusters permission claim needs the EDGES APIExport's
# identityHash (kcp hard-rejects hash-less claims on non-built-in types) —
# same discovery-file pattern as app-studio's hashes below.
kuery_hash_file = '.kcp/kuery-edges-identity-hash.env'
local_resource(
    'kuery-edges-identity-hash',
    cmd='''
set -eu
hash="$(kubectl --kubeconfig=%s --server=%s/clusters/root:railgrid:providers:edges \
  --insecure-skip-tls-verify get apiexport edges.providers.railgrid.ai \
  -o jsonpath='{.status.identityHash}' 2>/dev/null || true)"
if [ -z "$hash" ]; then
  echo "edges identityHash not discoverable yet - re-trigger after edges-init"
  exit 0
fi
printf 'edges=%%s\\n' "$hash" > %s
echo "wrote %s"
'''.strip() % (KCP_ADMIN_KUBECONFIG, KCP_ADMIN_SERVER, kuery_hash_file, kuery_hash_file),
    deps=['.kcp/edges-runtime.kubeconfig', 'tilt-frontproxy.kubeconfig'],
    allow_parallel=True,
    labels=['providers-kuery'],
)
kuery_edges_hash = ''
for _line in str(read_file(kuery_hash_file, '')).splitlines():
    if _line.startswith('edges='):
        kuery_edges_hash = _line[len('edges='):].strip()

provider_kubeconfig_sync('kuery', '.kcp/kuery-runtime.kubeconfig', ['providers-kuery'])
provider_pod(
    'kuery', 8084,
    container_port=8081,
    chart_extra=[
        'replicaCount=%s' % replica_count,
        'store.driver=postgres',
        'store.dsn=%s' % providers_db_url('kuery'),
        'apiExport.edgesIdentityHash=%s' % kuery_edges_hash,
    ],
    resource_deps=['kuery-secrets', 'providers-db'],
)

local_resource(
    'kuery-register',
    cmd=('{rewrite} && KUERY_KCP_KUBECONFIG={kc} ' +
         'KUERY_KCP_SERVER={sv} KUERY_MANIFEST={mf} ' +
         'make install-provider-kuery').format(
             rewrite=KUERY_REWRITE_CMD, kc=KCP_ADMIN_KUBECONFIG,
             sv=KCP_ADMIN_SERVER, mf=KUERY_MANIFEST_REWRITTEN),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['providers-kuery'],
)

local_resource(
    'kuery-init',
    cmd=('KUERY_KCP_KUBECONFIG={kc} KUERY_KCP_SERVER={sv} ' +
         'make init-provider-kuery').format(
             kc=KCP_ADMIN_KUBECONFIG, sv=KCP_ADMIN_SERVER),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub', 'kuery-register'],
    labels=['providers-kuery'],
)

local_resource(
    'kuery-unregister',
    cmd=('{rewrite} && KUERY_KCP_KUBECONFIG={kc} ' +
         'KUERY_KCP_SERVER={sv} KUERY_MANIFEST={mf} ' +
         'make uninstall-provider-kuery').format(
             rewrite=KUERY_REWRITE_CMD, kc=KCP_ADMIN_KUBECONFIG,
             sv=KCP_ADMIN_SERVER, mf=KUERY_MANIFEST_REWRITTEN),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['providers-kuery'],
)

# --- providers-kro ---
# Management kro: upstream kro installed INTO the same kind cluster kcp
# lives in (no separate railgrid-kro cluster like the embedded Tiltfile
# uses). kro is single-cluster — it never talks to kcp; the
# infrastructure provider's instance controller bridges kcp → this
# cluster, and the provider on the host reaches it via the kind
# cluster's host-published apiserver (KIND_HOST_KUBECONFIG).
# kro-mgmt-up is now MANUAL: the infrastructure-operator helm-installs
# kro itself. Kept as a fallback / for poking kro without the operator.
local_resource(
    'kro-mgmt-up',
    cmd=('KRO_TARGET_KUBECONFIG={kc} ' +
         'make dev-kro-up-into').format(kc=KIND_HOST_KUBECONFIG),
    deps=[
        'providers/infrastructure/examples/rgds',
    ],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    labels=['providers-kro'],
)

local_resource(
    'kro-mgmt-down',
    cmd=('KRO_TARGET_KUBECONFIG={kc} make dev-kro-down-into').format(
        kc=KIND_HOST_KUBECONFIG),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    labels=['providers-kro'],
)

# Infrastructure runs FULLY in-cluster via the chart's CRD-driven operator
# mode: the chart installs the operator (2 replicas of it are unnecessary —
# it is leader-elected in-cluster via controller-runtime), the operator
# bootstraps the provider kcp workspace with the synced admin kubeconfig,
# helm-installs kro into THIS cluster (in-cluster runtime, pod SA), deploys
# the serve Deployment (REPLICA_COUNT replicas — at 2, leader-elected
# Template/Instance controllers + bootstrap-loop leases), and self-registers the CatalogEntry
# with its serve Service URL.
provider_kubeconfig_sync('infrastructure', 'tilt-frontproxy.kubeconfig', ['providers-kro'])
# custom_build instead of docker_build: the OPERATOR deployment gets Tilt's
# content-hashed tag as usual, but the SERVE deployment is stamped by the
# operator from the CR's spec.provider.image — a split repo/tag field Tilt
# cannot inject into. Build once, tag it :dev additionally, and kind-load
# that tag so the CR-spawned pods resolve it locally.
# NB a rebuild does not restart the operator-owned serve pods (same :dev
# tag): kubectl -n railgrid-infrastructure-provider rollout restart deploy/infrastructure
custom_build(
    'railgrid-infrastructure-provider',
    ('docker build -f providers/infrastructure/Dockerfile -t $EXPECTED_REF . && ' +
     'docker tag $EXPECTED_REF railgrid-infrastructure-provider:dev && ' +
     'kind load docker-image railgrid-infrastructure-provider:dev --name %s') % cluster_name,
    deps=['providers/infrastructure', 'provider-sdk'],
)
k8s_yaml(helm(
    'providers/infrastructure/deploy/chart',
    name='infrastructure',
    namespace=providers_namespace,
    set=[
        'fullnameOverride=infrastructure',
        'image.repository=railgrid-infrastructure-provider',
        'image.pullPolicy=IfNotPresent',
        'hub.url=https://railgrid-hub.%s.svc.cluster.local:9443' % hub_namespace,
        'hub.insecure=true',
        'hub.tokenSecretRef.name=railgrid-provider-hub-token',
        'hub.tokenSecretRef.key=token',
        'operator.enabled=true',
        'operator.clusterAdmin=true',
        'operator.providerWorkspace=root:railgrid:providers:infrastructure',
        'operator.providerKubeconfigSecret.name=railgrid-infrastructure-kubeconfig',
        'operator.providerKubeconfigSecret.key=kubeconfig',
        'operator.provider.image.repository=railgrid-infrastructure-provider',
        'operator.provider.image.tag=dev',
        'operator.provider.replicas=%s' % replica_count,
        'operator.provider.port=8082',
        # Application-template exposure + platform access gate, mapped from
        # the old host-serve env: the local envoy Gateway, the sslip.io apps
        # zone, and the in-cluster hub for the access-proxy protocol.
        'operator.application.baseDomain=%s' % app_base_domain,
        'operator.application.gateway.name=%s' % app_studio_preview_parent_gateway_name,
        'operator.application.gateway.namespace=envoy-gateway-system',
        'operator.publishing.baseDomain=%s' % app_base_domain,
        'operator.publishing.accessProxyImage=%s' % access_proxy_image,
        'operator.publishing.hubURL=https://railgrid-hub.%s.svc:9443' % hub_namespace,
        'operator.publishing.hubPublicURL=%s' % hub_external_url,
        'operator.publishing.insecure=true',
        'operator.publishing.publicScheme=https',
        'operator.publishing.publicPort=%s' % app_studio_preview_public_port,
        'operator.publishing.gateway.name=%s' % app_studio_preview_parent_gateway_name,
        'operator.publishing.gateway.namespace=envoy-gateway-system',
    ],
))
k8s_resource(
    'infrastructure-operator',
    resource_deps=['railgrid-hub', 'kcp-dns', 'infrastructure-secrets', 'access-proxy-image-load'],
    labels=['providers-kro'],
)

local_resource(
    'infrastructure-register',
    cmd=('{rewrite} && KROMC_KCP_KUBECONFIG={kc} KROMC_KCP_SERVER={sv} ' +
         'KROMC_MANIFEST={mf} make install-provider-infrastructure').format(
             rewrite=INFRA_REWRITE_CMD, kc=KCP_ADMIN_KUBECONFIG,
             sv=KCP_ADMIN_SERVER, mf=INFRA_MANIFEST_REWRITTEN),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['providers-kro'],
)

# One-shot bootstrap: installs CRDs, registers APIExport schemas, applies
# the Templates CachedResource, mints the runtime SA + token, writes the
# kubeconfig run-provider-infrastructure reads. Order:
#   infrastructure-register  → creates the workspace
#   infrastructure-init      → seeds the workspace + writes kubeconfig
#   infrastructure (long-lived) → picks up INFRASTRUCTURE_KUBECONFIG
# Manual so devs control when re-bootstrap happens (it overwrites the
# runtime kubeconfig and rotates the token).
local_resource(
    'infrastructure-init',
    # init reads kcp server URL from the kubeconfig — only the path needs
    # overriding. KRO_KUBECONFIG is also forwarded so init writes the seed
    # kro.run/cluster=true Secret into the same in-cluster kro install
    # (not the legacy railgrid-kro cluster).
    cmd=('KROMC_KCP_KUBECONFIG={kc} KRO_KUBECONFIG={kro} ' +
         'make init-provider-infrastructure').format(
             kc=KCP_ADMIN_KUBECONFIG, kro=KIND_HOST_KUBECONFIG),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub', 'infrastructure-register'],
    labels=['providers-kro'],
)

local_resource(
    'infrastructure-unregister',
    cmd=('{rewrite} && KROMC_KCP_KUBECONFIG={kc} KROMC_KCP_SERVER={sv} ' +
         'KROMC_MANIFEST={mf} make uninstall-provider-infrastructure').format(
             rewrite=INFRA_REWRITE_CMD, kc=KCP_ADMIN_KUBECONFIG,
             sv=KCP_ADMIN_SERVER, mf=INFRA_MANIFEST_REWRITTEN),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['providers-kro'],
)

# The CRD-driven operator now runs IN-CLUSTER via the chart (see the helm
# install above): it applies the InfrastructureProvider CRD/Secrets/CR and
# reconciles — bootstrapping the provider workspace, helm-installing kro into
# this cluster, and owning the serve Deployment. The old host-binary
# controller + skip-serve split is gone with the rest of the host providers.

# --- optional infrastructure operator + Config Connector Pub/Sub demo ------
# These three actions are deliberately manual and have no resource_deps. A
# normal `make tilt-cluster` therefore never downloads a cloud controller,
# imports a credential, enables a cloud-backed Template, or creates a billable
# resource. Together they demonstrate how an infrastructure Template uses KRO
# to compose a Config Connector CR in the operator-managed runtime. Click them
# in order only when the local .env contains a disposable
# RAILGRID_CONFIG_CONNECTOR_GCP_PROJECT and an absolute
# RAILGRID_CONFIG_CONNECTOR_GCP_CREDENTIALS_FILE (the legacy RAILGRID_E2E_GCP_*
# names remain accepted by the Make targets).
local_resource(
    'config-connector-install',
    cmd=('RAILGRID_E2E_TILT_RUNTIME_KUBECONFIG={runtime} ' +
         'make config-connector-install').format(runtime=KIND_HOST_KUBECONFIG),
    deps=[
        '.env',
        'providers/infrastructure/contrib/config-connector/install.sh',
    ],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    labels=['providers-kro'],
)

local_resource(
    'config-connector-enable',
    cmd=('RAILGRID_E2E_TILT_KUBECONFIG={admin} ' +
         'RAILGRID_E2E_TILT_RUNTIME_KUBECONFIG={runtime} ' +
         'RAILGRID_KCC_KCP_SERVER={server} ' +
         'make config-connector-enable').format(
             admin=KCP_ADMIN_KUBECONFIG, runtime=KIND_HOST_KUBECONFIG,
             server=KCP_ADMIN_SERVER),
    deps=[
        '.env',
        'providers/infrastructure/contrib/config-connector/enable.sh',
        'providers/infrastructure/contrib/config-connector/pubsub-template.yaml',
        'providers/infrastructure/contrib/lib/enable-template.sh',
    ],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    labels=['providers-kro'],
)

local_resource(
    'config-connector-smoke',
    cmd=('RAILGRID_E2E_TILT_KUBECONFIG={admin} ' +
         'RAILGRID_E2E_TILT_RUNTIME_KUBECONFIG={runtime} ' +
         'make config-connector-smoke').format(
             admin=KCP_ADMIN_KUBECONFIG, runtime=KIND_HOST_KUBECONFIG),
    deps=[
        '.env',
        'providers/infrastructure/contrib/config-connector/pubsub-template.yaml',
        'test/e2e/suites/tiltcluster/config_connector_gcp_test.go',
    ],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    labels=['providers-kro'],
)

# --- optional infrastructure operator + Terraform/Infrakube demo ----------
# These actions mirror the Config Connector lifecycle and remain default-off.
# Normal Tilt startup does not clone or build Infrakube, enable the Terraform
# Template, execute Terraform, or retain Terraform state.
local_resource(
    'terraform-install',
    cmd=('RAILGRID_E2E_TILT_RUNTIME_KUBECONFIG={runtime} ' +
         'TERRAFORM_KIND_CLUSTER_NAME={name} make terraform-install').format(
             runtime=KIND_HOST_KUBECONFIG, name=cluster_name),
    deps=[
        'providers/infrastructure/contrib/terraform/install.sh',
    ],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    labels=['providers-kro'],
)

local_resource(
    'terraform-enable',
    cmd=('RAILGRID_E2E_TILT_KUBECONFIG={admin} ' +
         'RAILGRID_E2E_TILT_RUNTIME_KUBECONFIG={runtime} ' +
         'RAILGRID_TERRAFORM_KCP_SERVER={server} ' +
         'make terraform-enable').format(
             admin=KCP_ADMIN_KUBECONFIG, runtime=KIND_HOST_KUBECONFIG,
             server=KCP_ADMIN_SERVER),
    deps=[
        'providers/infrastructure/contrib/lib/enable-template.sh',
        'providers/infrastructure/contrib/terraform/enable.sh',
        'providers/infrastructure/contrib/terraform/terraform-stack-template.yaml',
    ],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    labels=['providers-kro'],
)

local_resource(
    'terraform-smoke',
    cmd=('RAILGRID_E2E_TILT_KUBECONFIG={admin} ' +
         'RAILGRID_E2E_TILT_RUNTIME_KUBECONFIG={runtime} ' +
         'make terraform-smoke').format(
             admin=KCP_ADMIN_KUBECONFIG, runtime=KIND_HOST_KUBECONFIG),
    deps=[
        'providers/infrastructure/contrib/terraform/terraform-stack-template.yaml',
        'test/e2e/suites/tiltcluster/terraform_test.go',
    ],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    labels=['providers-kro'],
)

# --- providers-code (git repository management) ---
# Host binary on :8083, same shape as quickstart/infrastructure. register/init/
# unregister override KROMC_KCP_KUBECONFIG / KROMC_KCP_SERVER to the in-cluster
# kcp front-proxy (the embedded-kcp defaults are localhost). init-provider-code
# derives the runtime kubeconfig from that admin kubeconfig, so it reuses the
# front-proxy credential in cluster mode without a separate token.
# At REPLICA_COUNT=2: the controller lease keeps one active reconciler set while
# both serve REST/MCP. GitHub OAuth app credentials ride providers/code/.env
# → the code-env Secret, exactly like agents.
local_resource(
    'code-env',
    cmd='''
set -eu
if [ -f providers/code/.env ]; then
  kubectl --context %s -n %s create secret generic code-env \
    --from-env-file=providers/code/.env --dry-run=client -o yaml | \
    kubectl --context %s -n %s apply -f -
else
  kubectl --context %s -n %s create secret generic code-env \
    --dry-run=client -o yaml | kubectl --context %s -n %s apply -f -
fi
'''.strip() % (k8s_context(), providers_namespace, k8s_context(), providers_namespace,
               k8s_context(), providers_namespace, k8s_context(), providers_namespace),
    deps=['providers/code/.env'],
    labels=['providers-code'],
)
provider_kubeconfig_sync('code', '.kcp/code-runtime.kubeconfig', ['providers-code'])
provider_pod(
    'code', 8083,
    chart_extra=['replicaCount=%s' % replica_count, 'envFromSecret=code-env'],
    resource_deps=['code-secrets', 'code-env'],
    # THE one legitimate host forward: the GitHub OAuth flow is
    # browser → provider DIRECT (deliberately not through the hub's
    # authenticated proxy), and the OAuth App's registered callback is
    # http://localhost:8083/oauth/github/callback (GITHUB_OAUTH_REDIRECT_URL
    # in providers/code/.env). The container listens on 8083, so the pod
    # forward matches.
    port_forwards=['8083:8083'],
)

local_resource(
    'code-register',
    cmd=('{rewrite} && KROMC_KCP_KUBECONFIG={kc} KROMC_KCP_SERVER={sv} ' +
         'CODE_MANIFEST={mf} make install-provider-code').format(
             rewrite=CODE_REWRITE_CMD, kc=KCP_ADMIN_KUBECONFIG,
             sv=KCP_ADMIN_SERVER, mf=CODE_MANIFEST_REWRITTEN),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['providers-code'],
)

# Writes the runtime kubeconfig (derived from the front-proxy admin kubeconfig)
# and ensures the APIExportEndpointSlice. Order:
#   code-register → creates root:railgrid:providers:code
#   code-init     → writes kubeconfig + endpoint slice
#   code (serve)  → restarts when the kubeconfig dep appears
local_resource(
    'code-init',
    cmd=('KROMC_KCP_KUBECONFIG={kc} KROMC_KCP_SERVER={sv} ' +
         'make init-provider-code').format(
             kc=KCP_ADMIN_KUBECONFIG, sv=KCP_ADMIN_SERVER),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub', 'code-register'],
    labels=['providers-code'],
)

local_resource(
    'code-unregister',
    cmd=('{rewrite} && KROMC_KCP_KUBECONFIG={kc} KROMC_KCP_SERVER={sv} ' +
         'CODE_MANIFEST={mf} make uninstall-provider-code').format(
             rewrite=CODE_REWRITE_CMD, kc=KCP_ADMIN_KUBECONFIG,
             sv=KCP_ADMIN_SERVER, mf=CODE_MANIFEST_REWRITTEN),
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['providers-code'],
)

# At REPLICA_COUNT=2: serving resolves tenant clusters through the slice-backed
# authority on every replica; the controllers are leader-elected.




# --- tenant development setup -----------------------------------------------
# One manual action for the credentials and tenant objects needed by the
# App Studio + Code + Databricks local workflow. The script reads the
# gitignored repository-root .env and applies only the Secret/Connection
# resources. Provider registration/initialization are explicit prerequisites;
# tenant APIBindings are checked by the script before it creates Connections.
local_resource(
    'dev-tenant-setup',
    cmd='hack/scripts/dev-tenant-setup.sh',
    deps=[
        '.env',
        'hack/scripts/dev-tenant-setup.sh',
        'hack/dev/tenant-bootstrap.env.example',
    ],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub', 'code-init'],
    labels=['bootstrap'],
)

# --- Dev agent image (template-native development mode) ---
# The static control binary injected into dev-mode components; owned by the
# infrastructure provider (docs/app-studio-template-sandboxes.md §2).
local_resource(
    'dev-agent-image',
    cmd=('KRO_KIND_NAME={name} make load-dev-agent-image').format(
        name=cluster_name),
    deps=[
        'providers/infrastructure/dev-agent',
    ],
    labels=['providers-app-studio'],
)

# ---------------------------------------------------------------------------
# edges — kubernetes & server agents. All manual triggers (click ▶ in Tilt UI).
#
# Same flow as the embedded-kcp ./Tiltfile (lines ~224-279). Both Tiltfiles
# surface the hub at hub_external_url with the `dev-token` static token,
# so the agent make targets (dev-login-static, dev-edge-create, dev-run-edge,
# dev-run-ssh-server) work unchanged here.
#
# Workflow:
#   1. Click ▶ on `edge-{kube,server}-create` to log in via static token,
#      register the Edge with the hub, and write .env.edge.<type>.
#   2. Click ▶ on `edge-{kube,server}-agent` to run the agent.
#        - kubernetes: also spins up a `railgrid-agent` kind cluster on first run.
#        - server: also click ▶ on `ssh-server` so the agent has an SSH target.
#   3. Home Assistant (to exercise the Service kind + its MCP tools):
#        - kube edge:   ▶ `ha-kube-deploy`, then ▶ `ha-kube-forward` to onboard
#          and mint a long-lived token, then declare a Service against it
#          (portal → Services → Add service, or the example manifest in
#          providers/edges/contrib/manifests/homeassistant/).
#          NOTE: the Service (svc) path dials cluster DNS, so it needs the agent
#          INSIDE the cluster — stop `edge-kube-agent` and use
#          `edge-kube-agent-incluster` instead, or the probe 502s.
#        - server edge: install HA on the host; the agent discovers it and the
#          Service appears on its own — only the token needs attaching.
#
# `resource_deps=['railgrid-hub']` because the hub workload here is named
# railgrid-hub (it's `hub` in the embedded-kcp Tiltfile).
# ---------------------------------------------------------------------------
local_resource(
    'edge-kube-create',
    # 1. Drop any saved agent kubeconfig from a previous hub/kcp incarnation.
    #    A stale ~/.railgrid/agent-<edge>.kubeconfig points at an old workspace +
    #    revoked SA token; the agent would load it, skip re-registration, and
    #    fail every call with "workspace access not permitted" (User "").
    # 2. DEV_EDGE_NAME is passed explicitly (not left to the Makefile's `?=`
    #    default) because an inherited DEV_EDGE_NAME in the env defeats the
    #    TYPE-based default — a server create would otherwise reuse the kube
    #    name. Command-line vars win over both env and `?=`.
    cmd='rm -f ~/.railgrid/agent-dev-edge-kube-1.kubeconfig ~/.railgrid/agent-dev-edge-kube-1.json && make dev-login-static && make dev-edge-create TYPE=kubernetes DEV_EDGE_NAME=dev-edge-kube-1',
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['edges'],
)

local_resource(
    'edge-kube-agent',
    serve_cmd='make dev-run-edge TYPE=kubernetes',
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['edges'],
)

# Same agent, but as a Deployment INSIDE the edge cluster — the way the
# railgrid-agent chart runs it in production.
#
# Use this instead of `edge-kube-agent` when you need the Service (svc) path:
# a Service on a kube edge is dialled over cluster DNS
# (home-assistant.home.svc), which only resolves from inside the cluster. The
# host-run agent serves the k8s subresource fine but 502s on svc.
#
# Before clicking:
#   - stop `edge-kube-agent` — two agents for one edge fight over the tunnel;
#   - re-run `edge-kube-create` if a join token was already redeemed (the hub
#     clears it on first use, and this needs a fresh one).
#
# Networking: the hub is a ClusterIP in the kcp-tilt cluster, so the make target
# exposes it via a NodePort and points the agent at the kcp-tilt node IP — both
# clusters' nodes share the `kind` docker network. Only works in this Tiltfile;
# the embedded-kcp ./Tiltfile has no kcp-tilt cluster to reach.
local_resource(
    'edge-kube-agent-incluster',
    cmd='make dev-edge-agent-incluster',
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['edges'],
)

local_resource(
    'edge-server-create',
    # Same stale-kubeconfig cleanup + explicit DEV_EDGE_NAME as edge-kube-create
    # (see note there). The explicit name is what keeps a server create from
    # reusing the kube edge name when DEV_EDGE_NAME leaks in from the env.
    cmd='rm -f ~/.railgrid/agent-dev-edge-server-1.kubeconfig ~/.railgrid/agent-dev-edge-server-1.json && make dev-login-static && make dev-edge-create TYPE=server DEV_EDGE_NAME=dev-edge-server-1',
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['edges'],
)

local_resource(
    'edge-server-agent',
    serve_cmd='make dev-run-edge TYPE=server',
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['railgrid-hub'],
    labels=['edges'],
)

# openssh-server container — target for the server-edge agent.
# Pre-step removes any stale container left from a previous run so the
# named --name=openssh-server doesn't collide.
local_resource(
    'ssh-server',
    serve_cmd='docker rm -f openssh-server >/dev/null 2>&1; make dev-run-ssh-server',
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    labels=['edges'],
)

# Home Assistant inside the `railgrid-agent` kind cluster — a real target for the
# kube-edge Service path (spec.targetRef → home-assistant.home.svc:8123). Note
# this is the *agent's* kind cluster, not the one hosting kcp + the hub here.
# Creates it if edge-kube-agent hasn't yet, so no resource_deps; first run pulls
# a ~1.5GB image. See providers/edges/contrib/manifests/homeassistant/README.md.
local_resource(
    'ha-kube-deploy',
    cmd='make dev-deploy-homeassistant',
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    labels=['edges'],
)

# Home Assistant ships with no users, and a long-lived access token can only be
# minted from the UI — so onboarding needs a browser. Port-forward, open
# http://localhost:8123, then profile → Security → Long-lived access tokens.
local_resource(
    'ha-kube-forward',
    serve_cmd='make dev-homeassistant-forward',
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
    resource_deps=['ha-kube-deploy'],
    links=[link('http://localhost:8123', 'Home Assistant')],
    labels=['edges'],
)

print('  railgrid-hub:      %s (in-cluster, static token: dev-token)' % hub_external_url)

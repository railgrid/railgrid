# syntax=docker/dockerfile:1
# External shards use the same organization guard as the embedded Hub shard.
# Build from the repository root; this uses the existing pinned kcp dependency.
FROM --platform=$BUILDPLATFORM golang:1.26 AS build
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /workspace
COPY go.mod go.sum ./
COPY provider-sdk/go.mod provider-sdk/go.sum provider-sdk/
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /railgrid-kcp ./cmd/railgrid-kcp/

FROM gcr.io/distroless/static:nonroot
COPY --from=build /railgrid-kcp /railgrid-kcp
USER nonroot:nonroot
ENTRYPOINT ["/railgrid-kcp"]

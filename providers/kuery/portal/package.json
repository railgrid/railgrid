{
  "name": "railgrid-provider-kuery-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Kuery provider's portal-side micro-frontend. Built with Vite into a single main.js custom-element bundle plus static assets the railgrid hub serves under /ui/providers/kuery/.",
  "type": "module",
  "scripts": {
    "build": "vite build && npm run vendor-codemirror",
    "vendor-codemirror": "node vendor-codemirror.cjs",
    "dev": "vite",
    "test": "node --test --test-concurrency=1 *.test.mjs",
    "test:browser": "npm run build && playwright test",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "lucide-vue-next": "^0.475.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/cytoscape": "^3.21.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "codemirror": "^5.65.16",
    "typescript": "^5.6.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}

# Binaries
bin/
/railgrid
/railgrid-hub
/railgrid-agent
# `go build` inside providers/quickstart drops the module binary next to main.go
/providers/quickstart/provider-quickstart
/providers/quickstart/quickstart
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary
*.test

# Output
*.out
*.prof

# Go workspace
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
_output/
_artifacts/

# Portal build artifacts (copied from portal/dist for embed)
pkg/hub/portal/
# node_modules are never committed anywhere. dist/ is ignored for the hub
# portal and the THIRD-PARTY providers (their images build it in Docker);
# first-party providers (mcp, kubernetesedges, serveredges) COMMIT dist/
# because it embeds into the hub binary — keep them out of this list.
# (A slash in a pattern anchors it to the repo root, hence the explicit
# per-provider entries.)
**/portal/node_modules/
portal/dist/
portal/node_modules/
providers/*/portal/node_modules
providers/app-studio/portal/dist/*
!providers/app-studio/portal/dist/.gitkeep
providers/quickstart/portal/dist/
providers/infrastructure/portal/dist/
# Compiled provider binary (go build . into the provider dir); build via
# `make build-edges-provider` writes to bin/ instead.
providers/edges/edges-provider
providers/edges/provider-edges
# Provider portal build artifacts (Docker/CI rebuild them).
providers/edges/portal/dist/
providers/edges/portal/node_modules/
providers/code/portal/dist/
providers/kuery/portal/dist/
providers/sandbox/portal/dist/*
!providers/sandbox/portal/dist/.gitkeep

# Data dirs
data/
*.kubeconfig
# Downloaded kubeconfigs that don't end in .kubeconfig (e.g. code-kubeconfig (2).yaml)
*kubeconfig*.yaml
# Stray extension-less kubeconfig dumps at the repo root (a `kind export
# kubeconfig > tilt` once committed a client private key under this name).
/tilt
# Same story: a kind kubeconfig (client key included) was once committed as `kk`.
/kk

# Dev tools and certs
hack/tools/
certs/
# Per-cluster dev CA exported by `railgrid dev init` (<hub-cluster-name>-ca.crt)
*-ca.crt
dex.db
.kcp/
# hack/kcp-external.sh state for `make tilt KCP_IMAGE=…`: kcp's root directory
# (admin.kubeconfig, serving key) mounted into the container.
.kcp-external/
# hack/install state (kubeconfigs, pidfiles, hub-token); e2e uses .railgrid-install-e2e
.railgrid-install*/
.env
.kind-kubeconfig
.edge-kubeconfig
.hooks/

.kubeconfig-railgrid-agent
docs/Gemfile.lock
edge-kubeconfig
*.kubeconfig
.env
.planning/
.env.server
.env.edge
.env.edge.*
.site-kubeconfig
.env.edge.server
.env.edge.kubernetes
values.yaml
# …but Helm chart defaults and templates (some named *kubeconfig*.yaml) MUST
# be committed or the chart can't render.
!providers/*/deploy/chart/values.yaml
!providers/*/deploy/chart/templates/*.yaml
!deploy/charts/*/values.yaml
!deploy/charts/*/templates/*.yaml

# kuery dev sqlite store
kuery.db
kuery.db-shm
kuery.db-wal

